{
  "name": "zeeman-smart-task-manager",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend"
  ],
  "scripts": {
    "setup": "node scripts/setup.js",
    "seed": "node backend/src/seed.js",
    "docker:secrets": "node scripts/create-docker-secrets.js",
    "dev": "npm --prefix backend run dev",
    "start": "npm --prefix backend start",
    "test": "npm --prefix backend test",
    "test:e2e": "playwright test",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down"
  },
  "description": "ZeeMan role-based task manager",
  "dependencies": {
    "@netlify/database": "^1.1.0",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}
